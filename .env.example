# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated. No wildcard is accepted together with credentials.
CORS_ORIGINS=http://localhost:3000
# Set to true only when the process sits behind nginx, otherwise the rate
# limiter sees a single IP for every caller.
TRUST_PROXY=false

# Database: runtime may use the transaction pooler (6543).
# Migrations use the session pooler (5432) or a direct connection.
# URL-encode passwords. Use sslmode=verify-full with your trusted CA bundle.
DATABASE_URL=postgresql://facturo:facturo@localhost:5432/facturo?schema=public
DIRECT_URL=postgresql://facturo:facturo@localhost:5432/facturo?schema=public

# ─── Auth ───────────────────────────────────────────────────────────────────
# Minimum 32 characters. The app refuses to boot in production when a secret
# still contains "change_me" or is shorter than that.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# ─── Launch phase ───────────────────────────────────────────────────────────
# beta       — the interim strategy from docs/legal/risks-and-contacts.md: a
#              free trial that never reaches a real tax authority, a real card
#              or a real outside AI model. In production, boot refuses any
#              provider below other than "sandbox" while this is set.
# commercial — the legal/business checklist in that file is done. In
#              production, boot then refuses the sandbox e-Factura provider.
LAUNCH_PHASE=beta

# ─── e-Factura (SIA e-Factura, Serviciul Fiscal de Stat) ────────────────────
# sandbox — in-memory provider, no network calls, used for development and CI.
# sfs     — the real SFS integration.
EFACTURA_PROVIDER=sandbox
EFACTURA_BASE_URL=
EFACTURA_CLIENT_ID=
EFACTURA_CLIENT_SECRET=
# PEM or PKCS#12 material for the qualified signature, mounted as a file path.
EFACTURA_SIGNING_CERT_PATH=
EFACTURA_SIGNING_CERT_PASSWORD=
# Polling cadence for delivery/acceptance status, in seconds.
EFACTURA_POLL_INTERVAL_SECONDS=300

# ─── Payments (maib e-commerce) ─────────────────────────────────────────────
# sandbox — no network calls. maib — the real gateway.
MAIB_PROVIDER=sandbox
MAIB_BASE_URL=
MAIB_PROJECT_ID=
MAIB_PROJECT_SECRET=
# Used to validate the SHA-256 signature on the callback body.
MAIB_SIGNATURE_KEY=
MAIB_CALLBACK_URL=http://localhost:3001/billing/maib/callback
MAIB_SUCCESS_URL=http://localhost:3000/ro/billing/success
MAIB_FAIL_URL=http://localhost:3000/ro/billing/fail

# ─── Observability ──────────────────────────────────────────────────────────
# Empty DSN is valid: the app then behaves identically, just without reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug

# ─── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5

# Google sign-in (popup code flow): Web application client ID and client secret.
# The secret stays on this server; the browser only ever sees the client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI assistant ───────────────────────────────────────────────────────────
# sandbox: local heuristic, nothing leaves the server. openai: Responses API.
AI_PROVIDER=sandbox
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000
AI_DAILY_LIMIT=30
