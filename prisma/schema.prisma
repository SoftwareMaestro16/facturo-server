// Facturo — data model.
//
// Two rules govern every table here and are not negotiable:
//   1. Every business row carries `companyId`, and every query filters by it.
//      This is the only thing standing between one customer's invoices and
//      another's.
//   2. Money is Decimal, never Float. Quantities are Decimal(12, 3).
//
// Retention: fiscal documents and the evidence of what was transmitted must be
// kept for six years. Nothing under Invoice or EfacturaSubmission is hard
// deleted before that, including when a company closes its account.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy and people ──────────────────────────────────────────────────────

model Company {
  id        String  @id @default(cuid())
  /// IDNO — the 13-digit state registration number.
  idno      String  @unique
  name      String
  /// VAT registration code. Null until the company crosses the threshold.
  vatCode   String?
  isVatPayer Boolean @default(true)
  address   String?
  city      String?
  country   String  @default("MD")
  email     String?
  phone     String?
  iban      String?
  bankName  String?
  bankBic   String?
  /// Interface language of the account: "ro" or "ru".
  locale    String  @default("ro")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Users whose *current* company this is — see the note on User.companyId.
  users          User[]
  memberships    Membership[]
  counterparties Counterparty[]
  products       Product[]
  invoices       Invoice[]
  subscription   Subscription?
  payments       Payment[]
  importJobs     ImportJob[]
  auditEvents    AuditEvent[]
  numberSeries   NumberSeries[]

  @@index([createdAt])
}

enum UserRole {
  OWNER
  ACCOUNTANT
  VIEWER
}

model User {
  id        String   @id @default(cuid())
  /// The company a freshly issued session defaults to. Nullable: a person who
  /// just signed in with Google and has not created or joined a company yet
  /// has an identity but no company — see AllowNoCompany and its guard check.
  /// Authorization for a *specific* request never reads this column; it reads
  /// the JWT's own companyId, which the person may have switched away from
  /// this default without it changing here.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  email        String    @unique
  phone        String?
  /// Null for a Google-only account: nothing to compare a login attempt against.
  passwordHash String?
  googleSubject String? @unique
  fullName     String
  /// Vestigial once a person has more than one company — Membership.role is
  /// authoritative there. Kept as the role of their *current* company so a
  /// row in this table still describes one coherent person without a join.
  role         UserRole  @default(OWNER)
  isActive     Boolean   @default(true)

  /// Lockout state. Cleared on a successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Which edition of the Terms and Privacy Policy this person accepted, and
  /// when. Text beside a button is not a record; this is.
  termsVersion    String?
  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  memberships Membership[]

  @@index([companyId, isActive])
}

/// One person can run several real companies — an accountant with client
/// firms, an entrepreneur with more than one LLC. This table is what makes
/// that possible: it is the authoritative record of who may act as whom,
/// while User.companyId/role stay a denormalised "last used" convenience so
/// the single-company code paths never had to learn about a join.
model Membership {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      UserRole @default(OWNER)

  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. A stolen copy of this table is worthless.
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  /// Set when this session was rotated, pointing at its replacement. Reuse of a
  /// rotated token means the token leaked, and the whole chain gets revoked.
  replacedById String?

  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  REGISTER
  PASSWORD_CHANGED
  SESSION_ROTATED
  SESSION_REVOKED
  INVOICE_SENT
  INVOICE_STATUS_CHANGED
  PAYMENT_RECEIVED
}

model AuditEvent {
  id        String         @id @default(cuid())
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId    String?
  type      AuditEventType
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime       @default(now())

  @@index([companyId, type, createdAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Counterparty {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  idno       String
  vatCode    String?
  isVatPayer Boolean @default(true)
  address    String?
  email      String?
  phone      String?
  iban       String?
  bankName   String?
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([companyId, idno])
  @@index([companyId, isArchived, name])
}

model Product {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String?
  name String
  /// Unit of measure, classifier code per the national UCM list (e.g. "H87").
  unit String  @default("H87")
  /// Net unit price, VAT excluded.
  priceNet Decimal @db.Decimal(12, 2)
  /// 20, 8, 0 or exempt. Stored as a rate, not an enum, because the list moves.
  vatRate  Decimal @db.Decimal(5, 2) @default(20)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId, isArchived, name])
}

/// Per-company draft numbering, kept as a row so the next number can be handed
/// out inside the same transaction that creates the invoice.
///
/// This is not the fiscal series: those are assigned by the State Tax Service.
/// This numbering exists so a draft has a stable handle before the platform has
/// seen it, and so the customer recognises their own document in a list.
model NumberSeries {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  series    String
  nextValue Int     @default(1)
  isDefault Boolean @default(false)

  @@unique([companyId, series])
}

// ─── Invoices ────────────────────────────────────────────────────────────────

enum InvoiceDirection {
  OUTGOING
  INCOMING
}

/// Which lifecycle the supplier chose when issuing the document.
///
/// SHORT ("ciclu scurt"): the document reaches its final state on the supplier's
/// second signature. The supplier then prints it, signs by hand and hands the
/// paper to the buyer.
///
/// LONG ("ciclu lung"): the buyer signs electronically and the document never
/// leaves the system. This is the one that matters after the October 2026
/// mandate, and the one Facturo defaults to.
enum InvoiceCycle {
  SHORT
  LONG
}

/// Mirrors the states a document actually has in SIA "e-Factura", plus one of
/// our own.
///
/// Naming follows the platform rather than a tidier scheme of our own, because
/// the customer sees these words on the state portal and in their accountant's
/// vocabulary, and two different names for one state is how support calls start.
enum InvoiceStatus {
  /// "Nouă" — editable, exists only in Facturo, not yet known to the platform.
  DRAFT
  /// "Semnată" — the supplier's first electronic signature is applied.
  SIGNED
  /// "Expediată" — handed to the platform and visible to the buyer.
  SENT
  /// "Recepționată" — the buyer has taken delivery in the system.
  RECEIVED
  /// "Finisată" — final. Short cycle: the supplier's second signature. Long
  /// cycle: the buyer's signature. Nothing follows except cancellation.
  FINISHED
  /// The supplier asked to cancel a finished long-cycle document. It stays here
  /// until the buyer accepts the cancellation in the system.
  CANCELLATION_REQUESTED
  /// "Anulată" — cancelled.
  CANCELLED
  /// Not a platform state. Our submission failed; `statusReason` carries a
  /// sentence a human can act on, never an API code.
  ERROR
}

model Invoice {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  direction InvoiceDirection
  status    InvoiceStatus    @default(DRAFT)
  cycle     InvoiceCycle     @default(LONG)
  /// Why the invoice is in its current status, phrased for a human.
  statusReason String?

  series String
  number Int
  issueDate    DateTime @db.Date
  deliveryDate DateTime? @db.Date
  dueDate      DateTime? @db.Date

  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  /// Counterparty details are copied onto the invoice at issue time. A later
  /// edit to the directory must never rewrite a document already sent.
  counterpartyName    String
  counterpartyIdno    String
  counterpartyVatCode String?
  counterpartyAddress String?

  currency String  @default("MDL")
  subtotal Decimal @db.Decimal(12, 2) @default(0)
  vatTotal Decimal @db.Decimal(12, 2) @default(0)
  total    Decimal @db.Decimal(12, 2) @default(0)

  notes String?

  /// Transport block. Required by the standard invoice form when goods move;
  /// left empty for services. The loading and unloading points are rows 5 and 6
  /// of the form and are what a tax inspection looks at first for goods.
  loadingPoint    String?
  unloadingPoint  String?
  transporterName String?
  transporterIdno String?
  vehicleNumber   String?
  driverName      String?

  /// Identifier assigned by the e-Factura platform. Null until the platform has
  /// accepted the document.
  ///
  /// The series and number of a fiscal invoice are issued by the State Tax
  /// Service, not chosen by us: `series` and `number` above are Facturo's own
  /// draft numbering, and these three fields hold what the platform assigned.
  efacturaId     String?
  efacturaSeries String?
  efacturaNumber String?
  sentAt         DateTime?
  /// When the document reached FINISHED.
  finishedAt     DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       InvoiceLine[]
  submissions EfacturaSubmission[]

  @@unique([companyId, series, number])
  @@index([companyId, direction, status, issueDate])
  @@index([companyId, counterpartyId, issueDate])
  @@index([efacturaId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position  Int
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name     String
  unit     String  @default("H87")
  quantity Decimal @db.Decimal(12, 3)
  priceNet Decimal @db.Decimal(12, 2)
  vatRate  Decimal @db.Decimal(5, 2)

  /// Derived from the four fields above, stored so a historical document never
  /// changes when the rounding rules are revisited.
  amountNet   Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  amountGross Decimal @db.Decimal(12, 2)

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

enum SubmissionState {
  QUEUED
  IN_FLIGHT
  SUCCEEDED
  FAILED
}

/// One row per attempt to hand a document to the e-Factura platform. Kept
/// verbatim: when the platform disputes what was sent, this is the evidence.
model EfacturaSubmission {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  attempt      Int
  state        SubmissionState @default(QUEUED)
  requestXml   String?
  responseRaw  String?
  errorCode    String?
  errorMessage String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([invoiceId, attempt])
  @@index([state, createdAt])
}

// ─── Billing (maib e-commerce) ───────────────────────────────────────────────

enum PlanCode {
  FREE
  STARTER
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan   PlanCode           @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  /// Outgoing invoices allowed in the current period. Null means unlimited.
  invoiceQuota Int?
  invoicesUsed Int  @default(0)

  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  /// maib billerId for the saved card, when the customer opted into recurring
  /// charges. Never store card numbers — only this token.
  maibBillerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan     PlanCode
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("MDL")
  status   PaymentStatus @default(PENDING)

  /// Identifier returned by maib for this transaction.
  maibPayId String? @unique
  /// The callback body as received, for reconciliation against the bank.
  rawCallback Json?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([companyId, status, createdAt])
}

// ─── Bulk import ─────────────────────────────────────────────────────────────

enum ImportKind {
  COUNTERPARTIES
  PRODUCTS
}

enum ImportStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model ImportJob {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind      ImportKind
  status    ImportStatus @default(PENDING)
  fileName  String
  totalRows Int          @default(0)
  okRows    Int          @default(0)
  errorRows Int          @default(0)
  /// Row number to human-readable reason, so the customer can fix the sheet.
  errors    Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([companyId, createdAt])
}
